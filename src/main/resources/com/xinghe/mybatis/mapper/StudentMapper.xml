<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xinghe.mybatis.mapper.StudentMapper">

    <select id="selectById" resultType="Student">
        SELECT id, student_no, name, gender, major, grade, enrollment_date
        FROM student
        WHERE id = #{id}
    </select>

</mapper>