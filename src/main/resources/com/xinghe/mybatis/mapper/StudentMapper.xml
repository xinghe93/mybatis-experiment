<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xinghe.mybatis.mapper.StudentMapper">

    <insert id="insert"
            parameterType="Student"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO student (student_no, name, gender, major, grade, enrollment_date)
        VALUES (#{studentNo}, #{name}, #{gender}, #{major}, #{grade}, #{enrollmentDate})
    </insert>

    <select id="selectById" resultType="Student">
        SELECT id, student_no, name, gender, major, grade, enrollment_date
        FROM student
        WHERE id = #{id}
    </select>

    <update id="updateById">
        UPDATE student
        <set>
            <if test="studentNo != null">
                student_no = #{studentNo},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="major != null">
                major = #{major},
            </if>
            <if test="grade != null">
                grade = #{grade},
            </if>
            <if test="enrollmentDate != null">
                enrollment_date = #{enrollmentDate},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM student
        WHERE id = #{id}
    </delete>

    <!-- 公共查询条件，供条件查询和统计复用 -->
    <sql id="studentCondition">
        <where>
            <if test="_parameter != null">
                <if test="name != null and name != ''">
                    AND name LIKE CONCAT('%', #{name}, '%')
                </if>
                <if test="gender != null and gender != ''">
                    AND gender = #{gender}
                </if>
                <if test="major != null and major != ''">
                    AND major = #{major}
                </if>
                <if test="grade != null">
                    AND grade = #{grade}
                </if>
            </if>
        </where>
    </sql>

    <select id="selectByCondition" resultType="Student">
        SELECT id, student_no, name, gender, major, grade, enrollment_date
        FROM student
        <include refid="studentCondition"/>
        ORDER BY id
    </select>

    <select id="selectByIds" resultType="Student">
        SELECT id, student_no, name, gender, major, grade, enrollment_date
        FROM student
        <choose>
            <when test="ids != null and ids.size() > 0">
                WHERE id IN
                <foreach collection="ids"
                         item="id"
                         open="("
                         separator=","
                         close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
        ORDER BY id
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*)
        FROM student
        <include refid="studentCondition"/>
    </select>

    <select id="selectPage" resultType="Student">
        SELECT id, student_no, name, gender, major, grade, enrollment_date
        FROM student
        ORDER BY id
        LIMIT #{offset}, #{pageSize}
    </select>

</mapper>